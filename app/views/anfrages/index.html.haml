%h1 Anfragen

%table.ui.table.anfrageTable

  %thead
    %tr
      %th Name
      %th E-Mail
      %th Telefon
      %th Pers. Anzahl
      %th Anfrage vom
      %th Datum
      %th Nachricht
      %th Antwort
      %th
      %th
      %th

  %tbody
    - @anfrages.sort_by { |a| a.created_at || Time.at(0) }.reverse.each do |anfrage|
      %tr
        %td= anfrage.name
        %td= anfrage.email
        %td= anfrage.telefon
        %td= anfrage.anzahl
        %td= anfrage.created_at&.strftime("%d.%m.%y") || "-"
        %td= "#{anfrage.startDate&.strftime('%d.%m.%y') || '-'} - #{anfrage.endDate&.strftime('%d.%m.%y') || '-'}"
        %td= anfrage.nachricht.present? ? anfrage.nachricht&.truncate(10) : "-"
        %td= check(anfrage.antwort)
        %td
          = link_to anfrage_path(anfrage), :class => "popup", :"data-content" => "Zeigen" do
            %i.eye.icon
        %td
          = link_to edit_anfrage_path(anfrage), :class => "popup", :"data-content" => "Bearbeiten" do
            %i.edit.outline.icon
        %td
          = link_to anfrage, method: :delete, :class => "popup", data: { confirm: 'Wirklich löschen?', content: "Löschen" }, style: "margin-left: 5px" do
            %i.trash.alternate.outline.icon

%br

:javascript
  $(document).ready(function () {
    var mieterTable = $('.anfrageTable').DataTable({
      columnDefs: [
        {bSortable: false, targets: [8,9,10]} 
      ],
      /*"order": [[ 4, "asc" ]]*/
      aaSorting: []
    });

    mieterTable.buttons().container().appendTo( $('div.nine.column:eq(0)', mieterTable.table().container()) );
    
    $('.ui.button', mieterTable.buttons().container()).addClass('basic')
  });